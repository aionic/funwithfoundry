%%{init: {"theme":"neutral","layout":"elk","flowchart":{"nodeSpacing":80,"rankSpacing":100,"subGraphTitleMargin":{"top":12,"bottom":30}}}}%%
flowchart LR
    operator["Authorized demo caller<br/>Central US jumpbox MI"]

    subgraph scus_runtime["South Central US - ingestion services, not a VNet boundary"]
        ingestion["Ingestion Function<br/>Entra and input validation"]
        fixture["Deterministic synthetic fixture<br/>Generated inside Function"]
        staging["Blob Storage<br/>Staged source bytes"]
        analysis["Content Understanding<br/>analyzeBinary and poll"]
        index_write["Function extraction<br/>Provenance and per-document status"]
    end

    sharepoint["Optional SharePoint Online<br/>Source of record via Graph"]
    transit["SCUS Function integration subnet<br/>SCUS firewall - vWAN - CUS firewall"]

    subgraph cus_search["Central US - Search PaaS"]
        index["Text and semantic index<br/>Derived content, no vectors"]
        iq["Foundry IQ knowledge base<br/>Retrieval planner"]
    end

    subgraph cus_foundry["Central US - Foundry PaaS and hosted application"]
        agent["Native Python hosted agent<br/>Responses request"]
        iq_call["Required IQ invocation<br/>Full current question"]
        toolbox["Required versioned toolbox<br/>Read-only Search, query_type simple"]
        gate["Result gate<br/>Both current calls must succeed"]
        synthesis["Tool-free synthesis<br/>Untrusted evidence and source IDs"]
    end

    planner_model["Foundry planner model deployment<br/>GlobalStandard processing"]
    answer_model["Foundry answer model deployment<br/>GlobalStandard processing"]
    failure["Explicit failure<br/>No grounded answer"]
    answer["Grounded answer and source metadata<br/>Or uncertainty when evidence is insufficient"]

    operator -->|"1. HTTPS POST via Function PE; Ingestion.Invoke"| ingestion
    ingestion -->|"2. Default: load constrained fixture"| fixture
    ingestion -.->|"2. Optional: Graph HTTPS via SCUS firewall; Sites.Selected"| sharepoint
    ingestion -->|"3. Stage selected bytes via Blob PE"| staging
    ingestion -->|"4. Send bytes via Content Understanding PE"| analysis
    ingestion -->|"5. Extract completed analysis; validate content"| index_write
    index_write -->|"5. Authenticated Search indexing"| transit
    transit -->|"5. HTTPS via CUS Search PE"| index
    operator -->|"6. After successful ingestion: Responses via Foundry PE"| agent
    agent -->|"7. Invoke IQ first"| iq_call
    iq_call -->|"7. Search PE; knowledgeBases retrieve"| iq
    iq -->|"Retrieve indexed source content"| index
    iq -->|"Model HTTPS via approved SPL"| planner_model
    iq_call -->|"8. After IQ result recorded, invoke toolbox"| toolbox
    toolbox -->|"8. Simple query via Search PE"| index
    iq_call -.->|"Current IQ result and references"| gate
    toolbox -->|"9. Current toolbox result"| gate
    gate -->|"Any failed, empty, or mismatched result"| failure
    gate -->|"Both validated"| synthesis
    synthesis -->|"10. Responses model request; no tools"| answer_model
    synthesis -->|"10. Validate text; append retrieved metadata"| answer
    synthesis -->|"Synthesis failure"| failure

    legend["Solid: runtime invocation or data/control flow<br/>Dashed: optional or secondary runtime relationship<br/>PE = private endpoint; SPL = shared private link<br/>Physical placement is in the topology contract<br/>GlobalStandard processing is not region-pinned; no control-plane deployment flow"]
